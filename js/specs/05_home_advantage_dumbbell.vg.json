{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Dumbbell (range) charts for Australia's five home Games. Left: Australia's share of all medals at the home Games (green) compared with the overseas Games immediately before and after (grey). Right: the same comparison for the size of the Australian team.",
  "data": {
    "url": "data/home_advantage.csv",
    "format": {
      "type": "csv",
      "parse": {"home_year": "number", "share": "number", "gold_share": "number", "team": "number"}
    }
  },
  "spacing": 36,
  "hconcat": [
    {
      "width": 460,
      "height": 230,
      "title": {"text": "Share of all medals won", "fontSize": 15, "font": "Barlow Semi Condensed"},
      "encoding": {
        "y": {
          "field": "home_games",
          "type": "nominal",
          "title": null,
          "sort": {"field": "home_year", "order": "ascending"},
          "axis": {
            "domain": false,
            "ticks": false,
            "labelFontSize": 13,
            "labelFontWeight": 600,
            "labelPadding": 8,
            "grid": true,
            "gridDash": []
          }
        },
        "x": {
          "field": "share",
          "type": "quantitative",
          "title": null,
          "scale": {"domain": [0, 0.35]},
          "axis": {"format": ".0%", "tickCount": 4, "grid": false}
        }
      },
      "layer": [
        {
          "mark": {"type": "rule", "color": "#c9c4b7", "strokeWidth": 3},
          "encoding": {
            "x": {"aggregate": "min", "field": "share"},
            "x2": {"aggregate": "max", "field": "share"}
          }
        },
        {
          "mark": {"type": "point", "filled": true, "size": 120, "opacity": 1, "strokeWidth": 1.5},
          "encoding": {
            "shape": {
              "field": "kind",
              "type": "nominal",
              "scale": {
                "domain": ["Games before (away)", "Home Games", "Games after (away)"],
                "range": ["triangle-left", "circle", "triangle-right"]
              },
              "legend": null
            },
            "color": {
              "field": "kind",
              "type": "nominal",
              "scale": {
                "domain": ["Games before (away)", "Home Games", "Games after (away)"],
                "range": ["#8c8a83", "#00754F", "#8c8a83"]
              },
              "legend": null
            },
            "tooltip": [
              {"field": "games", "title": "Games"},
              {"field": "kind", "title": "Compared as"},
              {
                "field": "share",
                "type": "quantitative",
                "title": "Share of all medals",
                "format": ".1%"
              },
              {
                "field": "gold_share",
                "type": "quantitative",
                "title": "Share of all golds",
                "format": ".1%"
              },
              {"field": "team", "type": "quantitative", "title": "Australian athletes"}
            ]
          }
        },
        {
          "transform": [{"filter": "datum.kind == 'Home Games'"}],
          "mark": {"type": "text", "dy": -13, "fontSize": 12, "fontWeight": 700, "color": "#00664a"},
          "encoding": {"text": {"field": "share", "type": "quantitative", "format": ".0%"}}
        }
      ]
    },
    {
      "width": 460,
      "height": 230,
      "title": {"text": "Australian athletes sent", "fontSize": 15, "font": "Barlow Semi Condensed"},
      "encoding": {
        "y": {
          "field": "home_games",
          "type": "nominal",
          "title": null,
          "sort": {"field": "home_year", "order": "ascending"},
          "axis": {"domain": false, "ticks": false, "labels": false, "grid": true, "gridDash": []}
        },
        "x": {
          "field": "team",
          "type": "quantitative",
          "title": null,
          "scale": {"domain": [0, 500]},
          "axis": {"tickCount": 5, "grid": false}
        }
      },
      "layer": [
        {
          "mark": {"type": "rule", "color": "#c9c4b7", "strokeWidth": 3},
          "encoding": {"x": {"aggregate": "min", "field": "team"}, "x2": {"aggregate": "max", "field": "team"}}
        },
        {
          "mark": {"type": "point", "filled": true, "size": 120, "opacity": 1},
          "encoding": {
            "shape": {
              "field": "kind",
              "type": "nominal",
              "scale": {
                "domain": ["Games before (away)", "Home Games", "Games after (away)"],
                "range": ["triangle-left", "circle", "triangle-right"]
              },
              "legend": null
            },
            "color": {
              "field": "kind",
              "type": "nominal",
              "scale": {
                "domain": ["Games before (away)", "Home Games", "Games after (away)"],
                "range": ["#8c8a83", "#00754F", "#8c8a83"]
              },
              "legend": null
            },
            "tooltip": [
              {"field": "games", "title": "Games"},
              {"field": "kind", "title": "Compared as"},
              {"field": "team", "type": "quantitative", "title": "Australian athletes"}
            ]
          }
        },
        {
          "transform": [{"filter": "datum.kind == 'Home Games'"}],
          "mark": {"type": "text", "dy": -13, "fontSize": 12, "fontWeight": 700, "color": "#00664a"},
          "encoding": {"text": {"field": "team", "type": "quantitative"}}
        }
      ]
    }
  ]
}
