{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Origin–destination flow map of every overseas trip the Australian team has made to a Commonwealth Games, 1930–2026. Azimuthal equidistant projection centred on Canberra: every straight line from the centre is the shortest (great-circle) route and is drawn at its true length, and the dashed rings mark 5,000, 10,000 and 15,000 km. Host cities in Britain, New Zealand and western Canada are combined into one flow each. Line width = Australian team places across all Games held there; labels give how often Australia topped the medal table there. The 15,000 km ring is highlighted: Australia finished first at 11 of the 13 Games inside it and 4 of the 10 beyond it. Green dots = the five Australian host cities (home Games).",
  "width": "container",
  "height": 580,
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "projection": {
    "type": "azimuthalEquidistant",
    "rotate": [
      -149.13,
      35.28,
      0
    ],
    "clipAngle": 158
  },
  "layer": [
    {
      "data": {
        "sphere": true
      },
      "mark": {
        "type": "geoshape",
        "fill": "#13222e",
        "stroke": "#2a3b48",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {
        "url": "data/geo/world_units.topojson",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#2b3c49",
        "stroke": "#13222e",
        "strokeWidth": 0.3
      }
    },
    {
      "data": {
        "url": "data/geo/distance_rings.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "filled": false,
        "stroke": "#7d909c",
        "strokeWidth": 0.9,
        "strokeDash": [
          3,
          4
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "label": "5,000 km",
            "lon": 149.13,
            "lat": -80.25
          },
          {
            "label": "10,000 km",
            "lon": -30.87,
            "lat": -54.79
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontStyle": "italic",
        "color": "#a9b4bb",
        "dy": -8
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "data": {
        "url": "data/geo/distance_rings.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.km == 15000"
        }
      ],
      "mark": {
        "type": "geoshape",
        "filled": false,
        "stroke": "#e9ecee",
        "strokeWidth": 1.4,
        "strokeDash": [
          5,
          4
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": -30.87,
            "lat": -29.5,
            "t": "Within 15,000 km of Canberra:",
            "w": 700,
            "c": "#e9ecee"
          },
          {
            "lon": -30.87,
            "lat": -22,
            "t": "Australia 1st at 11 of 13 Games",
            "w": 700,
            "c": "#e9ecee"
          },
          {
            "lon": -30.87,
            "lat": 1.6,
            "t": "Beyond it: 1st at 4 of 10, and England won the other six",
            "w": 700,
            "c": "#e9ecee"
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "Barlow Semi Condensed",
        "fontSize": 13,
        "fontWeight": 700,
        "color": "#e9ecee"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    },
    {
      "data": {
        "url": "data/games.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "lat": "number",
            "lon": "number",
            "aus_team": "number",
            "aus_total": "number",
            "aus_rank": "number",
            "km_from_canberra": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.home == 'Away'"
        },
        {
          "calculate": "indexof(['England','Scotland','Wales'], datum.host) >= 0 ? 'Britain' : datum.host == 'New Zealand' ? 'New Zealand' : indexof(['Vancouver','Victoria','Edmonton'], datum.city) >= 0 ? 'Western Canada' : datum.city",
          "as": "dest"
        },
        {
          "calculate": "datum.aus_rank == 1 ? 1 : 0",
          "as": "first"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "aus_team",
              "as": "athletes"
            },
            {
              "op": "count",
              "as": "games"
            },
            {
              "op": "sum",
              "field": "first",
              "as": "firsts"
            },
            {
              "op": "min",
              "field": "aus_rank",
              "as": "best"
            },
            {
              "op": "min",
              "field": "year",
              "as": "year"
            },
            {
              "op": "sum",
              "field": "aus_total",
              "as": "aus_medals"
            },
            {
              "op": "mean",
              "field": "lat",
              "as": "lat"
            },
            {
              "op": "mean",
              "field": "lon",
              "as": "lon"
            },
            {
              "op": "max",
              "field": "km_from_canberra",
              "as": "km"
            },
            {
              "op": "min",
              "field": "km_from_canberra",
              "as": "km_min"
            }
          ],
          "groupby": [
            "dest"
          ]
        },
        {
          "calculate": "-35.2809",
          "as": "o_lat"
        },
        {
          "calculate": "149.13",
          "as": "o_lon"
        },
        {
          "calculate": "datum.dest == 'Britain' ? 'London, Cardiff, Edinburgh ×2, Manchester, Glasgow ×2, Birmingham' : datum.dest == 'New Zealand' ? 'Auckland ×2, Christchurch' : datum.dest == 'Western Canada' ? 'Vancouver, Edmonton, Victoria' : datum.dest",
          "as": "cities"
        },
        {
          "calculate": "datum.best == 1 ? '1st' : datum.best == 2 ? '2nd' : datum.best == 3 ? '3rd' : datum.best + 'th'",
          "as": "place"
        },
        {
          "calculate": "datum.games > 1 ? '1st at ' + datum.firsts + ' of ' + datum.games + ' Games' : datum.place + ' in ' + datum.year",
          "as": "result"
        },
        {
          "calculate": "format(datum.athletes, ',') + ' places · ' + datum.result",
          "as": "sub"
        },
        {
          "calculate": "datum.km_min == datum.km ? format(datum.km, ',') : format(datum.km_min, ',') + '–' + format(datum.km, ',')",
          "as": "km_lab"
        }
      ],
      "params": [
        {
          "name": "hoverDest",
          "select": {
            "type": "point",
            "fields": [
              "dest"
            ],
            "on": "mouseover",
            "clear": "mouseout"
          }
        }
      ],
      "mark": {
        "type": "rule",
        "strokeCap": "butt",
        "cursor": "pointer"
      },
      "encoding": {
        "longitude": {
          "field": "o_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "o_lat",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "lon"
        },
        "latitude2": {
          "field": "lat"
        },
        "strokeWidth": {
          "field": "athletes",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1905
            ],
            "range": [
              1,
              24
            ]
          },
          "legend": null
        },
        "color": {
          "value": "#2fbf87"
        },
        "order": {
          "field": "athletes",
          "sort": "descending"
        },
        "opacity": {
          "condition": {
            "param": "hoverDest",
            "empty": true,
            "value": 0.85
          },
          "value": 0.15
        },
        "tooltip": [
          {
            "field": "dest",
            "title": "Destination"
          },
          {
            "field": "cities",
            "title": "Host cities"
          },
          {
            "field": "games",
            "type": "quantitative",
            "title": "Games held there"
          },
          {
            "field": "athletes",
            "type": "quantitative",
            "title": "Australian team places",
            "format": ","
          },
          {
            "field": "result",
            "title": "Australia on the medal table"
          },
          {
            "field": "km_lab",
            "title": "Distance from Canberra (km)"
          },
          {
            "field": "aus_medals",
            "type": "quantitative",
            "title": "Australian medals won there"
          }
        ]
      }
    },
