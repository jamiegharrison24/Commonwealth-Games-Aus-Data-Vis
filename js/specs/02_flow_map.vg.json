{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Origin–destination flow map of every overseas trip the Australian team has made to a Commonwealth Games, 1930–2026. Equal Earth (equal-area) projection rotated to centre on 140°E, so Australia sits in the middle with Britain to the left and Canada and the Caribbean to the right; flows are drawn as great-circle (shortest) routes from Canberra. Host cities in Britain, New Zealand and western Canada are combined into one flow each. Line width = Australian team places across all Games held there (see the line-width key); labels give how often Australia topped the medal table there. Distance itself is shown precisely in the distance line chart that follows. Green dots = the five Australian host cities (home Games).",
  "width": "container",
  "height": 420,
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "projection": {
    "type": "equalEarth",
    "rotate": [
      -140,
      0,
      0
    ],
    "scale": {
      "expr": "width/5.45"
    },
    "translate": {
      "expr": "[width/2, height*0.47]"
    }
  },
  "layer": [
    {
      "data": {
        "sphere": true
      },
      "mark": {
        "type": "geoshape",
        "fill": "#13222e",
        "stroke": "#2a3b48",
        "strokeWidth": 0.8,
        "clip": true
      }
    },
    {
      "data": {
        "url": "data/geo/world_units.topojson",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#2b3c49",
        "stroke": "#13222e",
        "strokeWidth": 0.3,
        "clip": true
      }
    },
    {
      "data": {
        "url": "data/games.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "lat": "number",
            "lon": "number",
            "aus_team": "number",
            "aus_total": "number",
            "aus_rank": "number",
            "km_from_canberra": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.home == 'Away'"
        },
        {
          "calculate": "indexof(['England','Scotland','Wales'], datum.host) >= 0 ? 'Britain' : datum.host == 'New Zealand' ? 'New Zealand' : indexof(['Vancouver','Victoria','Edmonton'], datum.city) >= 0 ? 'Western Canada' : datum.city",
          "as": "dest"
        },
        {
          "calculate": "datum.aus_rank == 1 ? 1 : 0",
          "as": "first"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "aus_team",
              "as": "athletes"
            },
            {
              "op": "count",
              "as": "games"
            },
            {
              "op": "sum",
              "field": "first",
              "as": "firsts"
            },
            {
              "op": "min",
              "field": "aus_rank",
              "as": "best"
            },
            {
              "op": "min",
              "field": "year",
              "as": "year"
            },
            {
              "op": "sum",
              "field": "aus_total",
              "as": "aus_medals"
            },
            {
              "op": "mean",
              "field": "lat",
              "as": "lat"
            },
            {
              "op": "mean",
              "field": "lon",
              "as": "lon"
            },
            {
              "op": "max",
              "field": "km_from_canberra",
              "as": "km"
            },
            {
              "op": "min",
              "field": "km_from_canberra",
              "as": "km_min"
            }
          ],
          "groupby": [
            "dest"
          ]
        },
        {
          "calculate": "-35.2809",
          "as": "o_lat"
        },
        {
          "calculate": "149.13",
          "as": "o_lon"
        },
        {
          "calculate": "datum.dest == 'Britain' ? 'London, Cardiff, Edinburgh ×2, Manchester, Glasgow ×2, Birmingham' : datum.dest == 'New Zealand' ? 'Auckland ×2, Christchurch' : datum.dest == 'Western Canada' ? 'Vancouver, Edmonton, Victoria' : datum.dest",
          "as": "cities"
        },
        {
          "calculate": "datum.best == 1 ? '1st' : datum.best == 2 ? '2nd' : datum.best == 3 ? '3rd' : datum.best + 'th'",
          "as": "place"
        },
        {
          "calculate": "datum.games > 1 ? '1st at ' + datum.firsts + ' of ' + datum.games + ' Games' : datum.place + ' in ' + datum.year",
          "as": "result"
        },
        {
          "calculate": "format(datum.athletes, ',') + ' places · ' + datum.result",
          "as": "sub"
        },
        {
          "calculate": "datum.km_min == datum.km ? format(datum.km, ',') : format(datum.km_min, ',') + '–' + format(datum.km, ',')",
          "as": "km_lab"
        },
        {
          "lookup": "dest",
          "from": {
            "data": {
              "url": "data/flow_paths.json"
            },
            "key": "dest",
            "fields": [
              "path"
            ]
          }
        },
        {
          "calculate": "{type:'Feature', properties:{}, geometry:{type:'LineString', coordinates: datum.path}}",
          "as": "geo"
        }
      ],
      "params": [
        {
          "name": "hoverDest",
          "select": {
            "type": "point",
            "fields": [
              "dest"
            ],
            "on": "mouseover",
            "clear": "mouseout"
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "filled": false,
        "strokeCap": "butt",
        "cursor": "pointer",
        "stroke": "#2fbf87"
      },
      "encoding": {
        "strokeWidth": {
          "field": "athletes",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1905
            ],
            "range": [
              1,
              {
                "expr": "22 * width / 735"
              }
            ]
          },
          "legend": null
        },
        "order": {
          "field": "athletes",
          "sort": "descending"
        },
        "opacity": {
          "condition": {
            "param": "hoverDest",
            "empty": true,
            "value": 0.85
          },
          "value": 0.15
        },
        "tooltip": [
          {
            "field": "dest",
            "title": "Destination"
          },
          {
            "field": "cities",
            "title": "Host cities"
          },
          {
            "field": "games",
            "type": "quantitative",
            "title": "Games held there"
          },
          {
            "field": "athletes",
            "type": "quantitative",
            "title": "Australian team places",
            "format": ","
          },
          {
            "field": "result",
            "title": "Australia on the medal table"
          },
          {
            "field": "km_lab",
            "title": "Distance from Canberra (km)"
          },
          {
            "field": "aus_medals",
            "type": "quantitative",
            "title": "Australian medals won there"
          }
        ],
        "shape": {
          "field": "geo",
          "type": "geojson"
        }
      }
    },
    {
      "data": {
        "url": "data/flow_paths.json"
      },
      "transform": [
        {
          "calculate": "{type:'Feature', properties:{}, geometry:{type:'Polygon', coordinates:[datum.arrow]}}",
          "as": "geo"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#2fbf87",
