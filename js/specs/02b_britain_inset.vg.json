{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Inset proportional symbol map of the six British host cities (eight Games). Circle area = Australian team places, added up over every Games held in that city. Labels give Australia's place on the medal table at each Games; gold text = Australia finished first. Equal Earth projection zoomed on Britain.",
  "width": "container",
  "height": 420,
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "projection": {
    "type": "equalEarth",
    "rotate": [
      2.6,
      -53.7,
      0
    ],
    "scale": {
      "expr": "height * 4.75"
    },
    "translate": {
      "expr": "[width / 2, height * 0.42]"
    }
  },
  "layer": [
    {
      "data": {
        "sphere": true
      },
      "mark": {
        "type": "geoshape",
        "fill": "#13222e",
        "stroke": null,
        "clip": true
      }
    },
    {
      "data": {
        "url": "data/geo/world_units.topojson",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#2b3c49",
        "stroke": "#13222e",
        "strokeWidth": 0.6,
        "clip": true
      }
    },
    {
      "data": {
        "url": "data/games.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "lat": "number",
            "lon": "number",
            "aus_team": "number",
            "aus_rank": "number",
            "aus_total": "number",
            "km_from_canberra": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "indexof(['England','Scotland','Wales'], datum.host) >= 0"
        },
        {
          "joinaggregate": [
            {
              "op": "sum",
              "field": "aus_team",
              "as": "places"
            },
            {
              "op": "count",
              "as": "n"
            }
          ],
          "groupby": [
            "city"
          ]
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "idx"
            }
          ],
          "groupby": [
            "city"
          ],
          "sort": [
            {
              "field": "year"
            }
          ]
        },
        {
          "calculate": "datum.aus_rank == 1 ? '1st' : datum.aus_rank == 2 ? '2nd' : datum.aus_rank == 3 ? '3rd' : datum.aus_rank + 'th'",
          "as": "place"
        },
        {
          "calculate": "datum.year + ': ' + datum.place",
          "as": "res"
        }
      ],
      "layer": [
        {
          "transform": [
            {
              "filter": "datum.idx == 1"
            }
          ],
          "mark": {
            "type": "circle",
            "color": "#2fbf87",
            "opacity": 0.85,
            "stroke": "#0b1620",
            "strokeWidth": 1.2,
            "clip": true
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "size": {
              "field": "places",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  700
                ],
                "range": [
                  0,
                  2600
                ],
                "zero": true
              },
              "legend": null
            },
            "order": {
              "field": "places",
              "sort": "descending"
            },
            "tooltip": [
              {
                "field": "city",
                "title": "Host city"
              },
              {
                "field": "n",
                "type": "quantitative",
                "title": "Games held"
              },
              {
                "field": "places",
                "type": "quantitative",
                "title": "Australian team places",
                "format": ","
              },
              {
                "field": "km_from_canberra",
                "type": "quantitative",
                "title": "Distance from Canberra (km)",
                "format": ","
              }
            ]
          }
        },
        {
          "transform": [
            {
              "filter": "datum.idx == 1"
            }
          ],
          "mark": {
            "type": "text",
            "font": "Barlow Semi Condensed",
            "fontSize": 13.5,
            "fontWeight": 700,
            "clip": true,
            "color": "#f2efe6",
            "align": {
              "expr": "(indexof(['Glasgow','Manchester','Cardiff'], datum.city) >= 0 ? 'left' : 'right') == 'left' ? 'right' : 'left'"
            },
            "dx": {
              "expr": "((indexof(['Glasgow','Manchester','Cardiff'], datum.city) >= 0 ? 'left' : 'right') == 'left' ? -1 : 1) * (sqrt(datum.places / 700 * 2600 / PI) + 6)"
            },
            "dy": {
              "expr": "(datum.city == 'Edinburgh' ? -8 : datum.city == 'Glasgow' ? 6 : 0) + -7"
            }
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "city"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "true"
            }
          ],
          "mark": {
            "type": "text",
            "font": "Barlow Semi Condensed",
            "fontSize": 12.5,
            "fontWeight": 700,
            "clip": true,
            "align": {
              "expr": "(indexof(['Glasgow','Manchester','Cardiff'], datum.city) >= 0 ? 'left' : 'right') == 'left' ? 'right' : 'left'"
            },
            "dx": {
              "expr": "((indexof(['Glasgow','Manchester','Cardiff'], datum.city) >= 0 ? 'left' : 'right') == 'left' ? -1 : 1) * (sqrt(datum.places / 700 * 2600 / PI) + 6)"
            },
            "dy": {
              "expr": "(datum.city == 'Edinburgh' ? -8 : datum.city == 'Glasgow' ? 6 : 0) + 8 + (datum.idx - 1) * 15"
            }
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "res"
            },
            "color": {
              "condition": {
                "test": "datum.aus_rank == 1",
                "value": "#f0c13f"
              },
              "value": "#a9b4bb"
            }
          }
        }
      ]
    },
    {
      "data": {
        "values": [
          {
            "v": 600,
            "t": "600",
            "r": 26.63411942942772
          },
          {
            "v": 300,
            "t": "300",
            "r": 18.833166459480722
          },
          {
            "v": 100,
            "t": "100",
            "r": 10.873333725074225
          }
        ]
      },
      "layer": [
        {
          "mark": {
            "type": "circle",
            "filled": false,
            "stroke": "#a9b4bb",
            "strokeWidth": 1
          },
          "encoding": {
            "size": {
              "field": "v",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  700
                ],
                "range": [
                  0,
                  2600
                ],
                "zero": true
              },
              "legend": null
            },
            "x": {
              "value": {
                "expr": "22+26.63"
              }
            },
            "y": {
              "value": {
                "expr": "height-16-datum.r"
              }
            }
          }
        },
        {
          "mark": {
            "type": "rule",
            "stroke": "#a9b4bb",
            "strokeWidth": 0.8,
            "strokeDash": [
              2,
              2
            ]
          },
          "encoding": {
            "x": {
              "value": {
                "expr": "22+26.63"
              }
            },
            "y": {
              "value": {
                "expr": "height-16-2*datum.r"
              }
            },
            "x2": {
              "value": {
                "expr": "22+53.27+40"
              }
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "fontSize": 12,
            "color": "#a9b4bb"
          },
          "encoding": {
            "text": {
              "field": "t"
            },
            "x": {
              "value": {
                "expr": "22+53.27+44"
              }
            },
            "y": {
              "value": {
                "expr": "height-16-2*datum.r"
              }
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "bottom",
            "fontSize": 12,
            "fontWeight": 600,
            "color": "#e9ecee",
            "text": [
              "Circle area = Australian team places,",
              "added up over every Games at that city"
            ],
            "lineHeight": 14,
            "dy": -14
          },
          "encoding": {
            "x": {
              "value": 22
            },
            "y": {
              "value": {
                "expr": "height-16-53.27-12"
              }
            }
          }
        }
      ]
    }
  ]
}