{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Unit chart: each row follows the Commonwealth athletes who won an individual Olympic athletics medal at one Olympics to the Commonwealth Games two years later (e.g. Mexico City 1968 to Edinburgh 1970). Each medal pictogram is one athlete. Filled = also won a medal at that Commonwealth Games; hollow = did not (absent, injured or beaten). A divider separates 1970–1990, when about half medalled, from 1994–2026, when fewer than a third did.",
  "width": "container",
  "height": {
    "step": 22
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "data": {
    "url": "data/olympians_at_cg.csv",
    "format": {
      "type": "csv",
      "parse": {
        "cg_year": "number",
        "oly_year": "number",
        "i": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum.cg_medal == 'Won a Commonwealth medal' ? 1 : 0",
      "as": "won"
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "won",
          "as": "n_won"
        },
        {
          "op": "count",
          "as": "n"
        }
      ],
      "groupby": [
        "cg_year"
      ]
    },
    {
      "calculate": "datum.n_won + ' of ' + datum.n + '  (' + format(datum.n_won / datum.n, '.0%') + ')'",
      "as": "lab"
    },
    {
      "calculate": "datum.cg_year < 1994 ? 'era1' : 'era2'",
      "as": "era"
    }
  ],
  "encoding": {
    "y": {
      "field": "cg_year",
      "type": "ordinal",
      "title": null,
      "sort": "ascending",
      "axis": {
        "domain": false,
        "ticks": false,
        "labelFontSize": 12.5,
        "labelFontWeight": 600,
        "labelPadding": 8,
        "labelExpr": "(datum.value - 2) + ' → ' + datum.value",
        "labelFont": "Barlow Semi Condensed"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "point",
        "size": 190,
        "strokeWidth": 1.3,
        "opacity": 1,
        "shape": "M-0.62,-1 L-0.22,-1 L0.02,-0.42 L-0.3,-0.36 Z M0.62,-1 L0.22,-1 L-0.02,-0.42 L0.3,-0.36 Z M0,-0.42 A0.68,0.68 0 1,1 0,0.94 A0.68,0.68 0 1,1 0,-0.42 Z",
        "filled": true
      },
      "encoding": {
        "x": {
          "field": "i",
          "type": "quantitative",
          "title": null,
          "scale": {
            "domain": [
              -0.8,
              58
            ]
          },
          "axis": null
        },
        "fill": {
          "field": "cg_medal",
          "type": "nominal",
          "scale": {
            "domain": [
              "Won a Commonwealth medal",
              "No Commonwealth medal"
            ],
            "range": [
              "#f2efe6",
              "#0b1620"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "title": null,
            "symbolStrokeColor": "#f2efe6",
            "symbolType": "M-0.62,-1 L-0.22,-1 L0.02,-0.42 L-0.3,-0.36 Z M0.62,-1 L0.22,-1 L-0.02,-0.42 L0.3,-0.36 Z M0,-0.42 A0.68,0.68 0 1,1 0,0.94 A0.68,0.68 0 1,1 0,-0.42 Z",
            "symbolSize": 190
          }
        },
        "stroke": {
          "value": "#f2efe6"
        },
        "tooltip": [
          {
            "field": "athlete",
            "title": "Athlete"
          },
          {
            "field": "noc",
            "title": "Nation (Olympic code)"
          },
          {
            "field": "event",
            "title": "Olympic event"
          },
          {
            "field": "oly_year",
            "title": "Olympics"
          },
          {
            "field": "oly_medal",
            "title": "Olympic medal"
          },
          {
            "field": "cg_year",
            "title": "Next Commonwealth Games"
          },
          {
            "field": "cg_medal",
            "title": "Result"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.i == 0"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 12.5,
        "font": "Barlow Semi Condensed",
        "fontWeight": 600,
        "color": "#e9ecee",
        "dx": 8
      },
      "encoding": {
        "x": {
          "field": "n",
          "type": "quantitative"
        },
        "text": {
          "field": "lab"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "cg_year": 1994
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#e9ecee",
        "strokeDash": [
          4,
          3
        ],
        "strokeWidth": 1,
        "yOffset": -11
      },
      "encoding": {
        "y": {
          "field": "cg_year",
          "type": "ordinal"
        },
        "x": {
          "datum": -0.8
        },
        "x2": {
          "datum": 58
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "cg_year": 1974,
            "t": [
              "1970–1990: about half",
              "(37 of 75) also won a",
              "Commonwealth medal"
            ],
            "c": "#e9ecee",
            "x": 26
          },
          {
            "cg_year": 2002,
            "t": [
              "1994–2026: under a third",
              "(80 of 265) did"
            ],
            "c": "#e9ecee",
            "x": 47
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 13,
        "fontWeight": 700,
        "font": "Barlow Semi Condensed",
        "lineHeight": 16,
        "yOffset": -6
      },
      "encoding": {
        "y": {
          "field": "cg_year",
          "type": "ordinal"
        },
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        },
        "color": {
          "field": "c",
          "type": "nominal",
          "scale": null
        }
      }
    }
  ]
}