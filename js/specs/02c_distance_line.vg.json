    {
      "data": {
        "url": "data/games.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "km_from_canberra": "number",
            "aus_team": "number"
          }
        }
      },
      "transform": [
        {
          "aggregate": [
            {
              "op": "count",
              "as": "games"
            },
            {
              "op": "min",
              "field": "km_from_canberra",
              "as": "x"
            },
            {
              "op": "min",
              "field": "year",
              "as": "first"
            }
          ],
          "groupby": [
            "city",
            "host",
            "home"
          ]
        },
        {
          "calculate": "0",
          "as": "y"
        },
        {
          "calculate": "format(datum.x / 20015, '.0%')",
          "as": "pct"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 110,
        "stroke": "#0b1620",
        "strokeWidth": 1.2,
        "opacity": 1,
        "cursor": "pointer"
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "datum.home == 'Home'",
            "value": "#2fbf87"
          },
          "value": "#f2efe6"
        },
        "tooltip": [
          {
            "field": "city",
            "title": "Host city"
          },
          {
            "field": "host",
            "title": "Country"
          },
          {
            "field": "games",
            "type": "quantitative",
            "title": "Games held"
          },
          {
            "field": "x",
            "type": "quantitative",
            "title": "Distance from Canberra (km)",
            "format": ","
          },
          {
            "field": "pct",
            "title": "Share of the way to the far side of the world"
          }
        ]
      }
