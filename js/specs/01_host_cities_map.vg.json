{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Proportional symbol map: the 23 host cities of the Commonwealth Games (1930-2026). Circle area = number of medal events; colour = nation that topped the medal table. Equal Earth (equal-area) projection. Region buttons re-centre and zoom the projection; the slider replays the Games in order.",
  "width": "container",
  "height": 500,
  "autosize": {"type": "fit-x", "contains": "padding"},
  "params": [
    {
      "name": "region",
      "value": "World",
      "bind": {
        "input": "radio",
        "options": ["World", "United Kingdom", "Australia & NZ", "Canada & Caribbean", "Asia"],
        "name": "Zoom to: "
      }
    },
    {
      "name": "upto",
      "value": 2026,
      "bind": {"input": "range", "min": 1930, "max": 2026, "step": 4, "name": "Show Games held up to: "}
    }
  ],
  "projection": {
    "type": "equalEarth",
    "rotate": {
      "expr": "region == 'United Kingdom' ? [3, -54.2, 0] : region == 'Australia & NZ' ? [-150, 34, 0] : region == 'Canada & Caribbean' ? [98, -36, 0] : region == 'Asia' ? [-89, -16, 0] : [-10, 0, 0]"
    },
    "scale": {
      "expr": "region == 'United Kingdom' ? width * 2.4 : region == 'Australia & NZ' ? width * 0.58 : region == 'Canada & Caribbean' ? width * 0.5 : region == 'Asia' ? width * 0.6 : width / 5.6"
    },
    "translate": {"expr": "[width / 2, height / 2]"}
  },
  "layer": [
    {
      "data": {"sphere": true},
      "mark": {"type": "geoshape", "fill": "#eef1f1", "stroke": "#d9dedf", "strokeWidth": 0.6, "clip": true}
    },
    {
      "data": {
        "url": "data/geo/graticule30.topojson",
        "format": {"type": "topojson", "feature": "graticule"}
      },
      "mark": {"type": "geoshape", "fill": null, "stroke": "#dfe5e6", "strokeWidth": 0.5, "clip": true}
    },
    {
      "data": {
        "url": "data/geo/world_units.topojson",
        "format": {"type": "topojson", "feature": "countries"}
      },
      "transform": [
        {
          "calculate": "indexof(['ACA','ACB','AIA','AUS','BGD','BHS','BLZ','BMU','BRB','BRN','BWA','CAN','CMR','COK','CYM','CYP','DMA','ENG','FJI','FLK','GAB','GGY','GHA','GIB','GMB','GRD','GUY','IMN','IND','JAM','JEY','KEN','KIR','KNA','LCA','LKA','LSO','MDV','MLT','MOZ','MSR','MUS','MWI','MYS','NAM','NFK','NGA','NIR','NIU','NRU','NZL','PAK','PNB','PNX','RWA','SCT','SGP','SHN','SLB','SLE','SWZ','SYC','TON','TTO','TUV','TZA','UGA','VCT','VGB','VUT','WLS','WSM','ZAF','ZMB'], datum.properties.GU_A3) >= 0 ? 'Commonwealth' : 'Other'",
          "as": "member"
        }
      ],
      "mark": {"type": "geoshape", "stroke": "#ffffff", "strokeWidth": 0.4, "clip": true},
      "encoding": {
        "fill": {
          "field": "member",
          "type": "nominal",
          "scale": {"domain": ["Commonwealth", "Other"], "range": ["#d6d1c4", "#ebe8e1"]},
          "legend": null
        }
      }
    },
    {
      "data": {
        "url": "data/games.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "lat": "number",
            "lon": "number",
            "events": "number",
            "medals_awarded": "number",
            "nations_medalled": "number",
            "aus_gold": "number",
            "aus_silver": "number",
            "aus_bronze": "number",
            "aus_total": "number",
            "aus_rank": "number",
            "aus_share": "number",
            "aus_gold_share": "number",
            "aus_team": "number",
            "medals_per_athlete": "number",
            "km_from_canberra": "number"
          }
        }
      },
      "transform": [
        {"filter": "datum.year <= upto"},
        {
          "calculate": "datum.top_code == 'AUS' ? 'Australia' : datum.top_code == 'ENG' ? 'England' : 'Canada'",
          "as": "Topped the medal table"
        }
      ],
      "mark": {
        "type": "circle",
        "stroke": "#ffffff",
        "strokeWidth": 1.2,
        "opacity": 0.82,
        "cursor": "pointer",
        "clip": true
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "size": {
          "field": "events",
          "type": "quantitative",
          "title": "Medal events",
          "scale": {"domain": [0, 300], "range": [0, 1100]},
          "legend": {
            "values": [50, 150, 280],
            "orient": "bottom-left",
            "symbolFillColor": "#ffffff",
            "symbolStrokeColor": "#6b6a64",
            "direction": "horizontal",
            "titleOrient": "left"
          }
        },
        "color": {
          "field": "Topped the medal table",
          "type": "nominal",
          "scale": {"domain": ["Australia", "England", "Canada"], "range": ["#00754F", "#E8833A", "#2C6FB5"]},
          "legend": null
        },
        "order": {"field": "events", "sort": "descending"},
        "tooltip": [
          {"field": "label", "type": "nominal", "title": "Games"},
          {"field": "host", "type": "nominal", "title": "Host nation"},
          {"field": "events", "type": "quantitative", "title": "Medal events"},
          {"field": "nations_medalled", "type": "quantitative", "title": "Nations that won a medal"},
          {"field": "Topped the medal table", "type": "nominal"},
          {"field": "aus_total", "type": "quantitative", "title": "Australian medals"},
          {"field": "aus_rank", "type": "quantitative", "title": "Australia's place"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {"lon": -2.5, "lat": 62.5, "t": "UK · 8 Games"},
          {"lon": -104, "lat": 60.5, "t": "Canada · 4"},
          {"lon": -76.8, "lat": 11.5, "t": "Jamaica · 1"},
          {"lon": 77.2, "lat": 34.5, "t": "India · 1"},
          {"lon": 101.7, "lat": 9.5, "t": "Malaysia · 1"},
          {"lon": 134, "lat": -18, "t": "Australia · 5"},
          {"lon": 172, "lat": -49, "t": "New Zealand · 3"}
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#3b3a36",
        "font": "Barlow Semi Condensed",
        "clip": true
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "t"}
      },
      "transform": [{"filter": "region == 'World'"}]
    },
    {
      "data": {
        "url": "data/host_city_labels.csv",
        "format": {"type": "csv", "parse": {"lat": "number", "lon": "number"}}
      },
      "transform": [{"filter": "region != 'World'"}],
      "layer": [
        {
          "mark": {
            "type": "text",
            "clip": true,
            "align": {"expr": "datum.side == 'left' ? 'right' : 'left'"},
            "dx": {"expr": "datum.side == 'left' ? -14 : 14"},
            "dy": -4,
            "fontSize": 14,
            "fontWeight": 700,
            "font": "Barlow Semi Condensed",
            "color": "#1d1d1b"
          },
          "encoding": {"text": {"field": "city"}}
        },
        {
          "mark": {
            "type": "text",
            "clip": true,
            "align": {"expr": "datum.side == 'left' ? 'right' : 'left'"},
            "dx": {"expr": "datum.side == 'left' ? -14 : 14"},
            "dy": 12,
            "fontSize": 12.5,
            "color": "#5d5b55"
          },
          "encoding": {"text": {"field": "years"}}
        }
      ],
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"}
      }
    }
  ]
}
